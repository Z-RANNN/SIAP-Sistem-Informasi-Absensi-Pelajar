<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!--
    Halaman "Laporan" khusus akun Guru: rekap absensi mata pelajaran milik
    guru yang sedang login saja (bukan lintas guru seperti "Laporan Kehadiran"
    versi Admin/Staf TU). Sidebar mengikuti struktur DashboardGuru.fxml
    (Beranda, Absensi Mata Pelajaran, Laporan) - lihat LaporanMapelController.
-->
<BorderPane prefHeight="900.0" prefWidth="1320.0" styleClass="dashboard-root"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nurulislam.siap.controller.LaporanMapelController">

    <!-- ================= Sidebar kiri (sama seperti DashboardGuru) ================= -->
    <left>
        <VBox prefWidth="240.0" styleClass="sidebar" spacing="4">
            <padding>
                <Insets top="20" right="16" bottom="20" left="16"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <padding>
                    <Insets bottom="20" top="4"/>
                </padding>
<ImageView fx:id="imgLogo" fitWidth="32" fitHeight="46" preserveRatio="true" smooth="true"/>
                <VBox spacing="1">
                    <Label text="SIAP" styleClass="sidebar-brand"/>
                    <Label text="Sistem Informasi Absensi Pelajar" styleClass="sidebar-brand-sub" wrapText="true"/>
                </VBox>
            </HBox>

            <Button fx:id="btnNavBeranda" text="Beranda" styleClass="nav-item" maxWidth="Infinity"/>
            <Button fx:id="btnNavJadwal" text="Jadwal Mengajar" styleClass="nav-item" maxWidth="Infinity"/>
            <Button fx:id="btnNavAbsensiMapel" text="Absensi Mata Pelajaran" styleClass="nav-item" maxWidth="Infinity"/>
            <Button fx:id="btnNavLaporan" text="Laporan" styleClass="nav-item, nav-item-active" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="system-status-box" spacing="4">
                <Label text="Sistem Aktif" styleClass="system-status-text"/>
            </VBox>
        </VBox>
    </left>

    <!-- ================= Konten utama ================= -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="dashboard-scroll">
            <VBox styleClass="dashboard-body" spacing="20">
                <padding>
                    <Insets top="24" right="32" bottom="32" left="32"/>
                </padding>

                <!-- Top bar -->
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox spacing="2">
                        <Label text="Laporan Kehadiran" styleClass="topbar-title"/>
                        <Label text="Rekap absensi mata pelajaran yang Anda ajar, dengan filter tanggal, kelas, mata pelajaran, dan status"
                               styleClass="greeting-caption" wrapText="true"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox styleClass="date-chip" alignment="CENTER_LEFT">
                        <Label fx:id="labelJamRealtime" text="Memuat…" styleClass="date-chip-text"/>
                    </VBox>
                    <VBox alignment="CENTER_RIGHT" spacing="1">
                        <Label fx:id="labelNamaUser" text="Memuat…" styleClass="user-name"/>
                        <Label fx:id="labelRoleUser" text="" styleClass="user-role"/>
                    </VBox>
                    <StackPane fx:id="avatarBox" styleClass="avatar-circle">
                        <ImageView fx:id="imgAvatar" fitWidth="40" fitHeight="40" preserveRatio="false"/>
                        <Label fx:id="labelInisialUser" text="G" styleClass="avatar-text"/>
                    </StackPane>
                </HBox>

                <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>

                <!-- Kartu Filter -->
                <VBox styleClass="card" spacing="14">
                    <Label text="Filter Laporan" styleClass="card-title"/>

                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Tanggal Mulai" styleClass="field-label"/>
                            <DatePicker fx:id="datePickerMulai" styleClass="text-field-rounded" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Tanggal Akhir" styleClass="field-label"/>
                            <DatePicker fx:id="datePickerAkhir" styleClass="text-field-rounded" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Pilihan Kelas" styleClass="field-label"/>
                            <ComboBox fx:id="comboKelasFilter" styleClass="combo-rounded" maxWidth="Infinity"
                                      promptText="Semua Kelas"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Mata Pelajaran" styleClass="field-label"/>
                            <ComboBox fx:id="comboMapelFilter" styleClass="combo-rounded" maxWidth="Infinity"
                                      promptText="Semua Mata Pelajaran"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Status" styleClass="field-label"/>
                            <ComboBox fx:id="comboStatusFilter" styleClass="combo-rounded" maxWidth="Infinity"
                                      promptText="Semua Status"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="10">
                        <Button fx:id="btnTerapkanFilter" text="Terapkan Filter" styleClass="btn-primary"/>
                        <Button fx:id="btnEksporPdf" text="Cetak / Ekspor PDF" styleClass="btn-secondary"/>
                    </HBox>
                </VBox>

                <!-- Kartu ringkasan -->
                <HBox spacing="16">
                    <VBox styleClass="stat-card, stat-card-green" HBox.hgrow="ALWAYS" spacing="10">
                        <StackPane styleClass="stat-icon, stat-icon-green">
                            <SVGPath content="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" fill="#006a65"/>
                        </StackPane>
                        <Label fx:id="labelTotalHadir" text="0" styleClass="stat-value"/>
                        <Label text="Total Hadir" styleClass="stat-label"/>
                    </VBox>

                    <VBox styleClass="stat-card, stat-card-teal" HBox.hgrow="ALWAYS" spacing="10">
                        <StackPane styleClass="stat-icon, stat-icon-teal">
                            <SVGPath content="M19 3H5c-1.1 0-1.99.9-1.99 2L3 19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-1 11h-4v4h-4v-4H6v-4h4V6h4v4h4v4z" fill="#006a65"/>
                        </StackPane>
                        <Label fx:id="labelIzinSakit" text="0" styleClass="stat-value"/>
                        <Label text="Izin / Sakit" styleClass="stat-label"/>
                    </VBox>

                    <VBox styleClass="stat-card, stat-card-orange" HBox.hgrow="ALWAYS" spacing="10">
                        <StackPane styleClass="stat-icon, stat-icon-orange">
                            <SVGPath content="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" fill="#a43c12"/>
                        </StackPane>
                        <Label fx:id="labelTerlambat" text="0" styleClass="stat-value"/>
                        <Label text="Terlambat" styleClass="stat-label"/>
                    </VBox>

                    <VBox styleClass="stat-card, stat-card-red" HBox.hgrow="ALWAYS" spacing="10">
                        <StackPane styleClass="stat-icon, stat-icon-red">
                            <SVGPath content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" fill="#ba1a1a"/>
                        </StackPane>
                        <Label fx:id="labelAlfa" text="0" styleClass="stat-value"/>
                        <Label text="Alfa" styleClass="stat-label"/>
                    </VBox>
                </HBox>

                <!-- Kartu Data Rekapitulasi -->
                <VBox styleClass="card" spacing="14" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="Data Rekapitulasi" styleClass="card-title"/>
                            <Label fx:id="labelJumlahData" text="Menampilkan 0 data" styleClass="card-subtitle"/>
                        </VBox>
                        <TextField fx:id="fieldPencarian" promptText="Cari nama siswa atau NIS..."
                                   styleClass="text-field-rounded" prefWidth="260"/>
                    </HBox>

                    <TableView fx:id="tabelLaporan" styleClass="tabel-akun" prefHeight="420">
                        <columns>
                            <TableColumn fx:id="kolomNamaSiswa" text="Nama Siswa" prefWidth="180"/>
                            <TableColumn fx:id="kolomNis" text="NIS" prefWidth="100"/>
                            <TableColumn fx:id="kolomKelas" text="Kelas" prefWidth="100"/>
                            <TableColumn fx:id="kolomMapel" text="Mata Pelajaran" prefWidth="160"/>
                            <TableColumn fx:id="kolomTanggal" text="Tanggal" prefWidth="120"/>
                            <TableColumn fx:id="kolomStatus" text="Status" prefWidth="110"/>
                            <TableColumn fx:id="kolomWaktuScan" text="Waktu Scan" prefWidth="110"/>
                            <TableColumn fx:id="kolomStatusSiswa" text="Status Siswa" prefWidth="105"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
